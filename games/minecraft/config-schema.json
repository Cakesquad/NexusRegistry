{
    "schemaVersion": 1,
    "metadata": {
        "name": "Minecraft Server Config",
        "description": "For Minecraft server.",
        "defaultPorts": [
            {
                "name": "game",
                "port": 25565,
                "protocols": ["tcp", "udp"]
            }
        ]
    },
    "groups": [
        {
            "id": "general",
            "label": "General",
            "fields": [
                {
                    "id": "serverName",
                    "label": "Server Name",
                    "type": "text",
                    "default": "My Minecraft Server",
                    "required": true,
                    "description": "The name of your Minecraft server."
                },
                {
                    "id": "motd",
                    "label": "MOTD",
                    "type": "text",
                    "default": "Welcome to my server!",
                    "required": false,
                    "description": "Message of the Day that appears in the Minecraft client."
                }
            ]
        },
        {
            "id": "version",
            "label": "Server Type & Version",
            "fields": [
                {
                    "id": "serverType",
                    "label": "Server Type",
                    "type": "select",
                    "options": [
                        {"value": "vanilla", "label": "Vanilla"},
                        {"value": "bedrock", "label": "Bedrock"},
                        {"value": "spigot", "label": "Spigot"},
                        {"value": "paper", "label": "Paper"},
                        {"value": "neoforge", "label": "NeoForge"},
                        {"value": "fabric", "label": "Fabric"}
                    ],
                    "default": "vanilla",
                    "required": true,
                    "description": "Select the type of Minecraft server you want to run."
                },
                {
                    "id": "serverVersion",
                    "label": "Server Version",
                    "type": "text",
                    "default": "latest",
                    "required": true,
                    "description": "Specify the version of the server. Use 'latest' for the most recent version."
                },
                {
                    "id": "javaVersion",
                    "label": "Java Version",
                    "type": "select",
                    "options": [
                        {"value": "java25", "label": "Java 25"},
                        {"value": "java21", "label": "Java 21"},
                        {"value": "java17", "label": "Java 17"},
                        {"value": "java16", "label": "Java 16"},
                        {"value": "java11", "label": "Java 11"},
                        {"value": "java8", "label": "Java 8"}
                    ],
                    "default": "java25",
                    "required": true,
                    "description": "Select the Java version to run the server."
                },
                {
                    "id": "releaseType",
                    "label": "Release Type",
                    "type": "select",
                    "options": [
                        {"value": "release", "label": "Release"},
                        {"value": "snapshot", "label": "Snapshot"},
                        {"value": "beta", "label": "Beta"}
                    ],
                    "default": "release",
                    "required": false,
                    "description": "Select the release type for the server.",
                    "visibleWhen": {
                        "field": "serverType",
                        "value": "vanilla"
                    }
                },
                {
                    "id": "neoForgeVersion",
                    "label": "NeoForge Version",
                    "type": "text",
                    "default": "latest",
                    "required": false,
                    "description": "Specify the version of NeoForge to use.",
                    "visibleWhen": {
                        "field": "serverType",
                        "value": "neoforge"
                    }
                }
            ]
        },
        {
            "id": "network",
            "label": "Network",
            "fields": [
                {
                    "id": "ports",
                    "predefined": true,
                    "type": "ports"
                }
            ]
        }
    ]
}
